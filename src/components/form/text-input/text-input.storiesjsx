import React, { useRef, useEffect } from 'react';
import { html, render } from 'lit';

import createComponent from '../../../utils/create-component';

import './text-input.define';
import { TextInput as TextInputElement } from './text-input';

export const TextInput = createComponent({
	tagName: 'xb-text-input',
	elementClass: TextInputElement,
	displayName: 'TextInput',
	events: {
		onChange: 'change',
		onInput: 'input',
	},
});

/** @type {import('../../../common/arg-types').Meta} */
const meta = {
	title: 'Components/Form/text input',
	component: 'xb-text-input',

	argTypes: {
		type: {
			control: 'select',
			options: ['text', 'password', 'number'],
		},
		disabled: {
			control: {
				type: 'boolean',
			},
		},
		input: {
			action: 'input',
			table: {
				disable: true,
			},
		},
		change: {
			action: 'change',
			table: {
				disable: true,
			},
		},
	},
	parameters: {},
};

export default meta;

function WebComponent({ args }) {
	/** @type {React.MutableRefObject<HTMLDivElement>} */
	const rootRef = useRef();
	/** @type {React.MutableRefObject<HTMLElement>} */
	const elementRef = useRef();

	useEffect(() => {
		render(
			html`
				<xb-text-input></xb-text-input>
			`,
			rootRef.current
		);

		elementRef.current = rootRef.current.querySelector(meta.component);

		let currentArgs = args;

		elementRef.current.disabled = currentArgs.disabled;
		elementRef.current.type = currentArgs.type;

		elementRef.current.addEventListener('change', currentArgs.change);
		elementRef.current.addEventListener('input', currentArgs.input);

		return () => {
			elementRef.current.removeEventListener('change', currentArgs.change);
			elementRef.current.removeEventListener('input', currentArgs.input);
		};
	}, [args]);

	return <div id="wc-root" ref={rootRef}></div>;
}

/** @type {import('../../../common/arg-types').StoryObj} */
export const Playground = {
	render: (args) => (
		<xb-stack>
			<WebComponent args={args} />

			<TextInput
				type={args.type}
				disabled={args.disabled}
				oninput={args.input}
				onchange={args.change}
			></TextInput>
		</xb-stack>
	),

	args: {
		type: 'text',
		disabled: false,
		size: 'small',
	},
};
