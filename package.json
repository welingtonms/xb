    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@storybook/addon-docs": "^10.1.2",
    "@storybook/react-webpack5": "^10.1.2",
    "aria-query": "5.3.2",
    "babel-loader": "^9.2.1",
