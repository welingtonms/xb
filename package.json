{
	"name": "@welingtonms/xb",
	"version": "0.0.0",
	"type": "module",
	"author": "Welington Silva",
	"license": "UNLICENSED",
	"packageManager": "yarn@3.8.7",
	"publishConfig": {
		"access": "public"
	},
	"description": "XB web components component library",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/welingtonms/xb.git"
	},
	"bugs": {
		"url": "https://github.com/welingtonms/xb/issues"
	},
	"readme": "https://github.com/welingtonms/xb#readme",
	"homepage": "https://github.com/welingtonms/xb#readme",
	"keywords": [
		"xb",
		"web components",
		"lit",
		"custom elements"
	],
	"files": [
		"src",
		"dist",
		"CONTEXT.md",
		"README.md"
	],
	"sideEffects": [
		"**/*.define.js",
		"**/*.register.js",
		"src/components/i18n/i18n.provider.js"
	],
	"exports": {
		"./package.json": "./package.json",
		"./xb-element": "./src/components/xb-element.js",
		"./floating-element": "./src/components/floating-element/index.js",
		"./form-element": "./src/components/form-element/index.js",
		"./tokens": "./src/themes/xb.theme.js",
		"./tokens/css": "./dist/tokens/variables.css",
		"./layout": "./src/components/layout/index.js",
		"./layout/register": "./src/components/layout/layout.define.js",
		"./form": "./src/components/form/index.js",
		"./form/register": "./src/components/form/form.define.js",
		"./form/checkbox": "./src/components/form/checkbox/index.js",
		"./form/checkbox/register": "./src/components/form/checkbox/checkbox.define.js",
		"./form/radio": "./src/components/form/radio/index.js",
		"./form/radio/register": "./src/components/form/radio/radio.define.js",
		"./form/select": "./src/components/form/select/index.js",
		"./form/select/register": "./src/components/form/select/select.define.js",
		"./form/switch": "./src/components/form/switch/index.js",
		"./form/switch/register": "./src/components/form/switch/switch.define.js",
		"./form/text-input": "./src/components/form/text-input/index.js",
		"./form/text-input/register": "./src/components/form/text-input/text-input.define.js",
		"./form/toggle-group": "./src/components/form/toggle-group/index.js",
		"./form/toggle-group/register": "./src/components/form/toggle-group/toggle-group.define.js",
		"./form/date-picker": "./src/components/form/date-picker/index.js",
		"./form/date-picker/register": "./src/components/form/date-picker/date-picker.register.js",
		"./i18n": "./src/components/i18n/index.js",
		"./button": "./src/components/button/index.js",
		"./button/register": "./src/components/button/button.define.js",
		"./badge": "./src/components/badge/index.js",
		"./badge/register": "./src/components/badge/badge.register.js",
		"./dialog": "./src/components/dialog/index.js",
		"./dialog/register": "./src/components/dialog/dialog.define.js",
		"./drawer": "./src/components/drawer/index.js",
		"./drawer/register": "./src/components/drawer/drawer.define.js",
		"./dropdown": "./src/components/dropdown/index.js",
		"./dropdown/register": "./src/components/dropdown/dropdown.define.js",
		"./field": "./src/components/field/index.js",
		"./field/register": "./src/components/field/field.define.js",
		"./icon": "./src/components/icon/index.js",
		"./icon/register": "./src/components/icon/icon.define.js",
		"./list": "./src/components/list/index.js",
		"./list/register": "./src/components/list/list.define.js",
		"./menu": "./src/components/menu/index.js",
		"./menu/register": "./src/components/menu/menu.define.js",
		"./separator": "./src/components/separator/index.js",
		"./separator/register": "./src/components/separator/separator.define.js",
		"./spinner": "./src/components/spinner/index.js",
		"./spinner/register": "./src/components/spinner/spinner.define.js",
		"./text": "./src/components/text/index.js",
		"./text/register": "./src/components/text/text.define.js",
		"./tooltip": "./src/components/tooltip/index.js",
		"./tooltip/register": "./src/components/tooltip/tooltip.define.js",
		"./top-nav": "./src/components/top-nav/index.js",
		"./top-nav/register": "./src/components/top-nav/top-nav.define.js",
		"./table": "./src/components/table/index.js",
		"./table/register": "./src/components/table/table.define.js"
	},
	"scripts": {
		"prebuild": "rm -rf dist",
		"prebuild:tokens": "node ./src/scripts/build-tokens.js",
		"prebuild:icons": "node ./src/scripts/convert-svg.js",
		"build": "yarn prebuild && yarn prebuild:tokens && yarn prebuild:icons",
		"release": "semantic-release",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:storybook": "vitest run --project storybook",
		"test:unit": "vitest run --project unit",
		"test:controllers": "vitest run --project controllers",
		"test:coverage": "vitest run --coverage",
		"verify:consumer": "node scripts/test-consumer.mjs",
		"verify:exports": "node scripts/verify-exports.mjs",
		"dev": "yarn storybook",
		"storybook": "storybook dev -p 6006",
		"build:docs": "storybook build -o ./docs"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/plugin-proposal-decorators": "^7.29.0",
		"@babel/preset-env": "^7.29.5",
		"@babel/preset-react": "^7.28.5",
		"@chromatic-com/storybook": "^5.2.1",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@faker-js/faker": "^10.4.0",
		"@github-ui/storybook-addon-performance-panel": "^1.1.4",
		"@semantic-release/github": "^12.0.8",
		"@semantic-release/npm": "^13.1.5",
		"@storybook/addon-docs": "^10.4.2",
		"@storybook/addon-vitest": "^10.4.2",
		"@storybook/react-vite": "^10.4.2",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/browser": "^4.1.8",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.8",
		"aria-query": "5.3.2",
		"glob": "13.0.6",
		"playwright": "^1.60.0",
		"prettier": "npm:wp-prettier@latest",
		"prop-types": "^15.8.1",
		"react": "^19.2.6",
		"react-dom": "19.2.6",
		"semantic-release": "^25.0.3",
		"storybook": "^10.4.2",
		"style-dictionary": "^5.4.1",
		"svgo": "^4.0.1",
		"vite": "^8.0.16",
		"vite-plugin-babel": "^1.7.3",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.7.6",
		"@lit/context": "^1.1.6",
		"@lit/react": "^1.0.8",
		"@welingtonms/classy": "^1.2.0",
		"composed-offset-position": "^0.0.6",
		"lit": "^3.3.3"
	}
}
