{
	"name": "@welingtonms/xb-wc",
	"version": "1.0.2",
	"description": "XB web components component library",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist",
	"files": [
		"dist/*"
	],
	"scripts": {
		"prebuild": "rm -rf dist",
		"build": "yarn prebuild && rollup -c --environment BUILD:prod",
		"dev": "storybook dev -p 8008",
		"build-docs": "storybook build -o ../../docs",
		"test": "cypress run --component --browser chrome",
		"cypress": "cypress open --component --browser chrome"
	},
	"keywords": [
		"xb",
		"web components",
		"lit"
	],
	"dependencies": {
		"@floating-ui/dom": "1.6.3",
		"@lit/react": "1.0.4",
		"@welingtonms/classy": "1.2.0",
		"@welingtonms/xb-icons": "workspace:*",
		"@welingtonms/xb-tokens": "workspace:*",
		"composed-offset-position": "0.0.4",
		"lit": "3.1.3"
	},
	"devDependencies": {
		"@babel/plugin-proposal-decorators": "7.24.1",
		"@babel/plugin-transform-class-properties": "7.24.1",
		"@babel/plugin-transform-private-methods": "7.24.1",
		"@babel/preset-env": "7.24.4",
		"@babel/preset-react": "7.24.1",
		"@chromatic-com/storybook": "^1.3.3",
		"@cypress/mount-utils": "4.1.0",
		"@storybook/addon-essentials": "^8.0.9",
		"@storybook/addon-interactions": "^8.0.9",
		"@storybook/addon-links": "^8.0.9",
		"@storybook/addon-onboarding": "^8.0.9",
		"@storybook/addon-webpack5-compiler-babel": "^3.0.3",
		"@storybook/blocks": "^8.0.9",
		"@storybook/jest": "0.2.3",
		"@storybook/react": "^8.0.9",
		"@storybook/react-webpack5": "^8.0.9",
		"@storybook/test": "^8.0.9",
		"@storybook/testing-library": "0.2.2",
		"aria-query": "5.3.0",
		"babel-loader": "9.1.3",
		"cypress": "13.3.3",
		"cypress-plugin-tab": "1.0.5",
		"prop-types": "^15.8.1",
		"react": "18.2.0",
		"react-dom": "18.2.0",
		"storybook": "^8.0.9"
	},
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://gitlab.com/welington/xb"
	},
	"bugs": {
		"url": "https://gitlab.com/welington/xb/-/issues"
	},
	"author": {
		"name": "Welington Silva"
	},
	"readme": "https://gitlab.com/welington/xb/-#readme",
	"homepage": "https://gitlab.com/welington/xb/-#readme"
}
